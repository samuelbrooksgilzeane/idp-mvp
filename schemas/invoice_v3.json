{
  "schema_id": "invoice",
  "schema_version": 3,
  "display_name": "Invoice v3",
  "use_case": "invoice",
  "status": "PRODUCTION",
  "instructions": "Extract only values explicitly stated in the source invoice. Do not infer, calculate, reconcile, or populate a missing value. Extract every billed line from the invoice line table as a separate item, preserving its stated order. Preserve stated signs and currency context. Return null when the source does not state a value.",
  "ai_extract_schema": {
    "invoice_number": {
      "type": "string",
      "description": "Invoice identifier exactly as stated by the seller."
    },
    "invoice_date": {
      "type": "string",
      "description": "Invoice issue date exactly as stated in the source document."
    },
    "seller_name": {
      "type": "string",
      "description": "Legal or trading name of the seller issuing the invoice."
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal stated before discounts and tax, without a currency symbol."
    },
    "discount": {
      "type": "number",
      "description": "Discount amount explicitly stated on the invoice, without a currency symbol."
    },
    "tax": {
      "type": "number",
      "description": "Total tax amount explicitly stated on the invoice, without a currency symbol."
    },
    "total": {
      "type": "number",
      "description": "Final invoice total explicitly stated as payable, without a currency symbol."
    },
    "currency": {
      "type": "string",
      "description": "Currency code or currency name explicitly stated for the invoice amounts."
    },
    "line_items": {
      "type": "array",
      "description": "Each billed line exactly as stated in the invoice line table.",
      "items": {
        "type": "object",
        "description": "One billed line from the invoice line table.",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of the billed item exactly as stated on the line."
          },
          "quantity": {
            "type": "number",
            "description": "Quantity stated for the line, without units."
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit stated for the line, without a currency symbol."
          },
          "tax": {
            "type": "number",
            "description": "Tax amount stated on the line itself, without a currency symbol."
          },
          "amount": {
            "type": "number",
            "description": "Line total stated for the line, without a currency symbol."
          }
        }
      }
    }
  },
  "field_policies": {
    "invoice_number": {
      "required": true,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high"
    },
    "invoice_date": {
      "required": true,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high",
      "semantic_type": "date"
    },
    "seller_name": {
      "required": true,
      "confidence_threshold": 0.85,
      "citation_required": true,
      "risk_tier": "medium"
    },
    "subtotal": {
      "required": false,
      "confidence_threshold": 0.85,
      "citation_required": true,
      "risk_tier": "medium"
    },
    "discount": {
      "required": false,
      "confidence_threshold": 0.8,
      "citation_required": true,
      "risk_tier": "medium"
    },
    "tax": {
      "required": false,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high"
    },
    "total": {
      "required": true,
      "confidence_threshold": 0.95,
      "citation_required": true,
      "risk_tier": "high"
    },
    "currency": {
      "required": true,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high",
      "semantic_type": "currency_code"
    },
    "line_items[*].description": {
      "required": false,
      "confidence_threshold": 0.7,
      "citation_required": false,
      "risk_tier": "low"
    },
    "line_items[*].quantity": {
      "required": false,
      "confidence_threshold": 0.85,
      "citation_required": true,
      "risk_tier": "medium"
    },
    "line_items[*].unit_price": {
      "required": false,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high"
    },
    "line_items[*].tax": {
      "required": false,
      "confidence_threshold": 0.85,
      "citation_required": true,
      "risk_tier": "medium"
    },
    "line_items[*].amount": {
      "required": false,
      "confidence_threshold": 0.9,
      "citation_required": true,
      "risk_tier": "high"
    }
  },
  "document_rules": [
    {
      "rule_id": "invoice_total_reconciliation",
      "rule_type": "arithmetic_reconciliation",
      "description": "Check that subtotal minus discount plus tax equals the stated total.",
      "field_paths": [
        "subtotal",
        "discount",
        "tax",
        "total"
      ],
      "tolerance": 0.01,
      "terms": [
        {
          "field_path": "subtotal",
          "sign": "+"
        },
        {
          "field_path": "discount",
          "sign": "-"
        },
        {
          "field_path": "tax",
          "sign": "+"
        }
      ],
      "target": "total"
    },
    {
      "rule_id": "required_invoice_identity",
      "rule_type": "required_fields",
      "description": "Check that the invoice number, invoice date, seller name, total, and currency are present.",
      "field_paths": [
        "invoice_number",
        "invoice_date",
        "seller_name",
        "total",
        "currency"
      ]
    },
    {
      "rule_id": "invoice_total_not_negative",
      "rule_type": "range",
      "description": "Reject a negative stated total; credit notes are not enabled for this contract.",
      "field_paths": [
        "total"
      ],
      "minimum": 0
    },
    {
      "rule_id": "invoice_currency_format",
      "rule_type": "format",
      "description": "Require a three-letter uppercase ISO currency code.",
      "field_paths": [
        "currency"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    {
      "rule_id": "discount_within_subtotal",
      "rule_type": "comparison",
      "description": "A stated discount must not exceed the stated subtotal.",
      "field_paths": [
        "discount"
      ],
      "comparator": "le",
      "compare_to": "subtotal"
    },
    {
      "rule_id": "line_items_reconcile_to_total",
      "rule_type": "arithmetic_reconciliation",
      "description": "Check that the billed lines, less the stated discount and plus line tax, equal the stated invoice total.",
      "field_paths": [
        "line_items[*].amount",
        "discount",
        "line_items[*].tax",
        "total"
      ],
      "tolerance": 0.01,
      "terms": [
        {
          "field_path": "line_items[*].amount",
          "sign": "+",
          "aggregate": "sum"
        },
        {
          "field_path": "discount",
          "sign": "-"
        },
        {
          "field_path": "line_items[*].tax",
          "sign": "+",
          "aggregate": "sum"
        }
      ],
      "target": "total"
    },
    {
      "rule_id": "line_items_sum_to_subtotal",
      "rule_type": "arithmetic_reconciliation",
      "description": "Check that the billed lines sum to the stated subtotal.",
      "field_paths": [
        "line_items[*].amount",
        "subtotal"
      ],
      "tolerance": 0.01,
      "terms": [
        {
          "field_path": "line_items[*].amount",
          "sign": "+",
          "aggregate": "sum"
        }
      ],
      "target": "subtotal",
      "severity": "WARNING"
    }
  ]
}
